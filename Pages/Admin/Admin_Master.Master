    <!-- Active menu detection -->
    <script>
        $(document).ready(function () {
            // Function to highlight active menu item
            function setActiveMenu() {
                // Get current page URL
                var currentUrl = window.location.pathname;
                var pageName = currentUrl.split("/").pop();

                // Remove active class from all menu items
                $('.sidebar-menu li').removeClass('active');
                $('.treeview-menu li').removeClass('active');

                // Check each menu item
                $('.sidebar-menu a').each(function () {
                    var menuUrl = $(this).attr('href');

                    // Check if the URL matches
                    if (menuUrl === pageName || (menuUrl !== '#' && currentUrl.includes(menuUrl))) {
                        $(this).parent().addClass('active');

                        // If this is a submenu item, also activate the parent
                        var parentMenu = $(this).closest('.treeview-menu');
                        if (parentMenu.length) {
                            parentMenu.addClass('show');
                            parentMenu.closest('.treeview').addClass('active');
                            parentMenu.prev('a').attr('aria-expanded', 'true');
                        }

                        return false; // Break out of the loop once found
                    }
                });

                // Special case for home page
                if (pageName === '' || pageName === 'Default.aspx' || pageName === 'Home.aspx') {
                    $('#homeMenuItem').addClass('active');
                }
            }

            // Initialize dropdowns
            $('.dropdown-toggle').dropdown();

            // Set active menu on page load
            setActiveMenu();

            // Handle sidebar collapse on mobile
            $('#sidebar').on('show.bs.collapse', function () {
                $('.content-wrapper').addClass('overlay');
            }).on('hide.bs.collapse', function () {
                $('.content-wrapper').removeClass('overlay');
            });

            // Automatically expand parent menu if a child is active
            if ($('.treeview-menu li.active').length) {
                var parentMenu = $('.treeview-menu li.active').closest('.treeview-menu');
                parentMenu.addClass('show');
                parentMenu.closest('.treeview').addClass('active');
                parentMenu.prev('a').attr('aria-expanded', 'true');
            }
        });

        // Ensure logout link triggers postback properly
        $(document).on("click", "#<%= btnLogout.ClientID %>", function (e) {
            __doPostBack('<%= btnLogout.UniqueID %>', '');
        });


    </script>
